# Copy to .env.local and fill in. NEVER commit .env.local (see .gitignore).
#
# Verbly handles Tier 1 data. The service-role key bypasses Row-Level Security
# and must ONLY be used in server-side code (Edge Functions / Next.js server
# actions / route handlers) — never exposed to the browser, never prefixed
# NEXT_PUBLIC_.

# --- Supabase (client-safe, exposed to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# --- Supabase (server-only, secret) ---
# Used only for privileged server operations (e.g. the cascade-delete Edge
# Function in API.md, seeding reviewed curriculum content). Do NOT expose.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Supabase (migrations only, secret) ---
# Direct Postgres connection URI. Used to apply migrations with the Supabase
# CLI (`supabase db push --db-url "$SUPABASE_DB_URL"`). Dashboard → Project
# Settings → Database → Connection string → URI. Contains the DB password —
# never commit, never expose to the browser.
SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres

# --- Email (Resend) ---
# RESEND_API_KEY is auto-populated by the Vercel Marketplace Resend integration
# once provisioned (`vercel integration add resend/resend-email`). Until a real
# key AND NOTIFICATIONS_FROM (a verified sending domain) are set, the cron
# dispatch runs in DRY-RUN — it plans + logs, but sends no mail.
RESEND_API_KEY=your-resend-api-key
# The verified "from" address, e.g. "Verbly <notifications@yourdomain.com>".
# Leave unset until you have a domain verified in Resend.
NOTIFICATIONS_FROM=

# --- Cron ---
# Shared secret for the scheduled notification dispatch. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. Generate a long random value.
CRON_SECRET=your-long-random-cron-secret
